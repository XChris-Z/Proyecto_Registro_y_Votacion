---
import MainLayout from '../layouts/MainLayout.astro';
import { obtenerJornadaActual, obtenerEstadisticasEnVivo, obtenerEstadoRegistro } from '@lib/db';
import { getLangFromCookie, useTranslations } from '../i18n/utils';

const lang = getLangFromCookie(Astro.cookies.get('lang')?.value);
const t = useTranslations(lang);

const error = Astro.url.searchParams.get('error');
const [jornadaActual, stats, registroActivo] = await Promise.all([
  obtenerJornadaActual(),
  obtenerEstadisticasEnVivo(),
  obtenerEstadoRegistro()
]);
const estaCerrada = jornadaActual.estado === 'CERRADA' || !registroActivo;
---

<MainLayout title="Registro de Asistencia">
  <section class="page-hero">
    <div class="container--narrow">
      <div class="page-hero__eyebrow animate-fade-up" style="animation-delay:0s;">
        {t('index.hero.eyebrow')}
      </div>
      <h1 class="page-hero__title animate-fade-up" style="animation-delay:0.1s;">
        {estaCerrada ? t('index.hero.title.closed') : t('index.hero.title.open')}
      </h1>
      <p class="page-hero__sub animate-fade-up" style="animation-delay:0.2s;">
        {estaCerrada
          ? t('index.hero.sub.closed')
          : t('index.hero.sub.open')}
      </p>
    </div>
  </section>

  <section style="padding-bottom:4rem;">
    <div class="container--narrow">
      <div class="glass animate-fade-up" style="padding:2.5rem;animation-delay:0.3s;">

        {error === 'closed' && (
          <div class="alert alert--error mb-3">
            {t('index.alert.closed')}
          </div>
        )}
        {error === 'fields' && (
          <div class="alert alert--error mb-3">
            {t('index.alert.fields')}
          </div>
        )}
        {error === 'documento' && (
          <div class="alert alert--error mb-3">
            {t('index.alert.documento')}
          </div>
        )}
        {error === 'correo' && (
          <div class="alert alert--error mb-3">
            {t('index.alert.correo')}
          </div>
        )}
        {error === 'telefono' && (
          <div class="alert alert--error mb-3">
            {t('index.alert.telefono')}
          </div>
        )}
        {error === 'duplicate' && (
          <div class="alert alert--error mb-3">
            {t('index.alert.duplicate')}
          </div>
        )}
        {error === 'server' && (
          <div class="alert alert--error mb-3">
            {t('index.alert.server')}
          </div>
        )}

        {estaCerrada ? (
          <div style="text-align:center;padding:1.5rem 0;">
            <div style="font-size:3.5rem;margin-bottom:1rem;">🔒</div>
            <span style="background:var(--clr-accent);color:#041815;font-weight:800;font-size:0.78rem;padding:0.4rem 1rem;border-radius:999px;">
              {t('index.closed.badge')}
            </span>
            <h2 style="font-size:1.8rem;margin-top:1.2rem;color:var(--clr-text);font-weight:800;">
              {jornadaActual.nombre}
            </h2>
            <p style="color:var(--clr-text-muted);font-size:1.02rem;max-width:520px;margin:1rem auto 2rem;line-height:1.6;">
              {t('index.closed.msg')}
            </p>
            <div style="border-top:1px solid var(--clr-border);padding-top:1.5rem;color:var(--clr-text-dim);font-size:0.85rem;">
              {t('index.closed.footer')}
            </div>
          </div>
        ) : (
          <form id="registro-form" method="POST" action="/api/registro" novalidate>
            <div style="display:grid;gap:1.25rem;">

              <!-- Nombre -->
              <div class="form-group">
                <label class="form-label" for="nombre">{t('index.form.nombre.label')}</label>
                <input
                  id="nombre"
                  class="form-input"
                  type="text"
                  name="nombre"
                  placeholder={t('index.form.nombre.placeholder')}
                  required
                  minlength="3"
                  autocomplete="name"
                />
              </div>

              <!-- Documento -->
              <div class="form-group">
                <label class="form-label" for="documento">{t('index.form.documento.label')}</label>
                <input
                  id="documento"
                  class="form-input"
                  type="text"
                  name="documento"
                  placeholder={t('index.form.documento.placeholder')}
                  required
                  pattern="[0-9]+"
                  inputmode="numeric"
                />
                <span class="form-hint">{t('index.form.documento.hint')}</span>
              </div>

              <!-- Dependencia -->
              <div class="form-group">
                <label class="form-label" for="dependencia">{t('index.form.dependencia.label')}</label>
                <input
                  id="dependencia"
                  class="form-input"
                  type="text"
                  name="dependencia"
                  placeholder={t('index.form.dependencia.placeholder')}
                  required
                  minlength="2"
                />
              </div>

              <!-- Correo -->
              <div class="form-group">
                <label class="form-label" for="correo">{t('index.form.correo.label')}</label>
                <input
                  id="correo"
                  class="form-input"
                  type="email"
                  name="correo"
                  placeholder={t('index.form.correo.placeholder')}
                  required
                  autocomplete="email"
                />
              </div>

              <!-- Teléfono -->
              <div class="form-group">
                <label class="form-label" for="telefono">{t('index.form.telefono.label')}</label>
                <input
                  id="telefono"
                  class="form-input"
                  type="tel"
                  name="telefono"
                  placeholder={t('index.form.telefono.placeholder')}
                  required
                  pattern="[0-9]{7,15}"
                  inputmode="numeric"
                  autocomplete="tel"
                />
                <span class="form-hint">{t('index.form.telefono.hint')}</span>
              </div>

              <!-- Botón -->
              <div style="margin-top:0.5rem;">
                <button id="submit-btn" type="submit" class="btn btn--primary btn--lg btn--full">
                  <span id="btn-text" data-loading-text={t('index.form.submitting')}>{t('index.form.submit')}</span>
                  <span id="btn-spinner" class="spinner hidden"></span>
                </button>
              </div>

              <p class="text-center" style="font-size:0.8rem;color:var(--clr-text-dim);">
                {t('index.form.privacy')}
              </p>

            </div>
          </form>
        )}
      </div>

      <!-- Sección de Estadísticas en Tiempo Real -->
      <div class="live-stats-section animate-fade-up" style="animation-delay:0.4s;">
        <div class="live-stats-header">
          <div class="live-badge">
            <span class="live-badge__dot"></span>
            <span>{t('index.stats.badge')}</span>
          </div>
          <span class="live-stats-header__title">{t('index.stats.title')}</span>
        </div>

        <div class="live-stats-grid">
          <!-- Personas Registradas -->
          <div class="live-stat-box">
            <div class="live-stat-box__icon">👥</div>
            <div class="live-stat-box__content">
              <div id="live-asistentes" class="live-stat-box__value">{stats.asistentes}</div>
              <div class="live-stat-box__label">{t('index.stats.registered.val')}</div>
              <div class="live-stat-box__sub">{t('index.stats.registered.sub')}</div>
            </div>
          </div>

          <!-- Total Votos Emitidos -->
          <div class="live-stat-box">
            <div class="live-stat-box__icon">🗳️</div>
            <div class="live-stat-box__content">
              <div id="live-votos" class="live-stat-box__value">{stats.votos}</div>
              <div class="live-stat-box__label">{t('index.stats.votes.val')}</div>
              <div class="live-stat-box__sub">{t('index.stats.votes.sub')}</div>
            </div>
          </div>
        </div>

        <div class="live-stats-footer">
          <span class="live-stats-footer__spinner"></span>
          <span>{t('index.stats.sync')}</span>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const form = document.getElementById('registro-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnSpinner = document.getElementById('btn-spinner') as HTMLSpanElement;

  // Validación en tiempo real
  const inputs = form.querySelectorAll<HTMLInputElement>('input[required]');
  inputs.forEach(input => {
    input.addEventListener('blur', () => validateInput(input));
    input.addEventListener('input', () => {
      if (input.classList.contains('error')) validateInput(input);
    });
  });

  function validateInput(input: HTMLInputElement) {
    const group = input.closest('.form-group');
    const existingError = group?.querySelector('.form-error');
    existingError?.remove();

    if (!input.validity.valid) {
      input.style.borderColor = 'var(--clr-error)';
      const errorEl = document.createElement('span');
      errorEl.className = 'form-error';
      errorEl.textContent = getErrorMsg(input);
      input.classList.add('error');
      group?.appendChild(errorEl);
    } else {
      input.style.borderColor = '';
      input.classList.remove('error');
    }
  }

  function getErrorMsg(input: HTMLInputElement): string {
    if (input.validity.valueMissing) return 'Este campo es obligatorio';
    if (input.validity.typeMismatch) return 'Ingresa un correo válido';
    if (input.validity.patternMismatch) return 'Solo se permiten números';
    if (input.validity.tooShort) return `Mínimo ${input.minLength} caracteres`;
    return 'Campo inválido';
  }

  form.addEventListener('submit', (e) => {
    let valid = true;
    inputs.forEach(input => {
      if (!input.validity.valid) {
        validateInput(input);
        valid = false;
      }
    });
    if (!valid) {
      e.preventDefault();
      return;
    }
    btnText.textContent = btnText.getAttribute('data-loading-text') || 'Registrando...';
    btnSpinner.classList.remove('hidden');
    submitBtn.disabled = true;
  });

  // Sincronización en tiempo real con /api/stats
  function updateLiveStats() {
    fetch('/api/stats')
      .then(res => res.json())
      .then(data => {
        if (data && data.success) {
          animateCountChange('live-asistentes', data.asistentes);
          animateCountChange('live-votos', data.votos);
        }
      })
      .catch(() => { /* Falla silenciosa si no hay red */ });
  }

  function animateCountChange(elementId: string, newValue: number) {
    const el = document.getElementById(elementId);
    if (!el) return;
    const currentValue = parseInt(el.textContent || '0', 10);
    if (currentValue !== newValue) {
      el.classList.add('updated');
      el.textContent = newValue.toString();
      setTimeout(() => el.classList.remove('updated'), 300);
    }
  }

  // Polling cada 4 segundos
  setInterval(updateLiveStats, 4000);
</script>
