---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { obtenerCategorias, obtenerProyectos } from '@lib/db';

const categorias = await obtenerCategorias();
const proyectos = await obtenerProyectos();
const msg = Astro.url.searchParams.get('msg');

const categoryColors = [
  { border: '#3B82F6', bg: 'rgba(59, 130, 246, 0.12)', text: '#2563EB' },
  { border: '#10B981', bg: 'rgba(16, 185, 129, 0.12)', text: '#059669' },
  { border: '#8B5CF6', bg: 'rgba(139, 92, 246, 0.12)', text: '#7C3AED' },
  { border: '#F59E0B', bg: 'rgba(245, 158, 11, 0.12)', text: '#D97706' },
  { border: '#EC4899', bg: 'rgba(236, 72, 153, 0.12)', text: '#DB2777' },
  { border: '#06B6D4', bg: 'rgba(6, 182, 212, 0.12)', text: '#0891B2' }
];
---

<AdminLayout title="Proyectos" activePage="proyectos">
  <div style="max-width:1000px;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
      <div>
        <h1 style="font-size:2rem;font-weight:800;margin-bottom:0.25rem;color:var(--clr-text);">Proyectos Candidatos</h1>
        <p style="color:var(--clr-text-muted);">Gestiona los proyectos habilitados para la votación institucional</p>
      </div>
      <div style="display:flex; gap:0.5rem;">
        <form id="form-importar" action="/api/admin/proyectos/importar" method="POST" enctype="multipart/form-data" style="display:none;">
          <input type="file" id="input-excel" name="excel" accept=".xlsx, .xls" onchange="document.getElementById('form-importar').submit();" />
        </form>
        <button class="btn btn--outline" style="border-radius:100px;padding:0.65rem 1.4rem;font-weight:700;" onclick="document.getElementById('input-excel').click()">
          📥 Importar desde Excel
        </button>
        <button class="btn btn--primary" style="border-radius:100px;padding:0.65rem 1.4rem;font-weight:700;box-shadow:0 4px 14px rgba(0, 89, 78, 0.25);" onclick="abrirModal()">
          + Agregar proyecto
        </button>
      </div>
    </div>

    {msg === 'created' && <div class="alert alert--success mb-3"><span>✅</span> Proyecto creado exitosamente</div>}
    {msg === 'updated' && <div class="alert alert--success mb-3"><span>✅</span> Proyecto actualizado</div>}
    {msg === 'deleted' && <div class="alert alert--success mb-3"><span>✅</span> Proyecto eliminado</div>}
    {msg === 'imported' && <div class="alert alert--success mb-3"><span>✅</span> Proyectos importados exitosamente</div>}
    {msg === 'error' && <div class="alert alert--danger mb-3"><span>❌</span> Error al realizar la operación</div>}

    {categorias.filter(c => c.activa === true).map((cat, index) => {
      const catProyectos = proyectos.filter(p => p.categoria_id === cat.id);
      const color = categoryColors[index % categoryColors.length];
      return (
        <div class="category-section" style={`margin-bottom:2rem;border:1.5px solid ${color.border};border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.03);`}>
          <div class="category-header" style={`background:${color.bg};border-bottom:1px solid ${color.border};padding:1.1rem 1.5rem;display:flex;justify-content:space-between;align-items:center;`}>
            <h3 style={`font-size:1.15rem;font-weight:800;margin:0;color:${color.text};display:flex;align-items:center;gap:0.45rem;`}>
              <span>🏷️</span> {cat.nombre}
            </h3>
            <span class="badge" style={`background:${color.border};color:#fff;`}>{catProyectos.length} proyecto{catProyectos.length !== 1 ? 's' : ''}</span>
          </div>
          <div class="projects-grid" style="padding:1.25rem; display:grid; grid-template-columns:repeat(auto-fill, minmax(240px, 1fr)); gap:1rem;">
            {catProyectos.length === 0 && (
              <div style="grid-column:1/-1;text-align:center;color:var(--clr-text-dim);padding:2rem;border:1px dashed var(--clr-border);border-radius:12px;">
                <span style="font-size:2rem;display:block;margin-bottom:0.5rem;opacity:0.5;">📭</span>
                Sin proyectos asignados a esta categoría.
                <br/>
                <button class="btn btn--outline btn--sm" style="margin-top:1rem;border-radius:100px;font-weight:700;" onclick={`abrirModal(null, ${cat.id})`}>
                  + Agregar Primer Proyecto
                </button>
              </div>
            )}
            {catProyectos.map(p => (
              <div class="project-admin-card" style={`background:var(--clr-surface);border:1px solid rgba(0,0,0,0.08);border-left:4px solid ${color.border};border-radius:10px;padding:1.15rem;display:flex;flex-direction:column;justify-content:space-between;gap:0.85rem;box-shadow:var(--shadow-sm);transition:transform 0.2s ease, box-shadow 0.2s ease;`}>
                <div>
                  <h4 style="margin:0 0 0.4rem;font-size:1.05rem;font-weight:800;color:var(--clr-text);line-height:1.25;">{p.nombre}</h4>
                  <p style="margin:0;font-size:0.82rem;color:var(--clr-text-muted);line-height:1.4;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;text-overflow:ellipsis;">{p.descripcion || <span style="opacity:0.5">Sin descripción</span>}</p>
                  <div style="margin-top:0.75rem;font-size:0.78rem;color:var(--clr-text-dim);display:flex;align-items:center;gap:0.35rem;font-weight:600;">
                    <span>👥</span> {p.autores || 'Autores no especificados'}
                  </div>
                </div>
                <div style="display:flex;gap:0.4rem;justify-content:flex-end;border-top:1px solid rgba(0,0,0,0.05);padding-top:0.85rem;margin-top:0.5rem;">
                  <button class="btn btn--outline btn--sm" style="border-radius:100px;padding:0.3rem 0.9rem;font-size:0.78rem;font-weight:700;" onclick={`abrirModal(${JSON.stringify(p)})`}>Editar</button>
                  <button class="btn btn--danger btn--sm" style="border-radius:100px;padding:0.3rem 0.9rem;font-size:0.78rem;font-weight:700;" onclick={`eliminarProyecto(${p.id}, '${p.nombre.replace(/'/g, "\\'")}')`}>Eliminar</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}

    {categorias.length === 0 && (
      <div class="alert alert--info">
        <span>ℹ️</span> Primero crea categorías antes de agregar proyectos.
        <a href="/admin/categorias" style="margin-left:0.5rem;font-weight:600;">Ir a Categorías →</a>
      </div>
    )}
  </div>

  <!-- Modal Proyecto -->
  <div class="modal-overlay" id="modal-overlay">
    <div class="modal" style="max-width:520px;">
      <h3 id="modal-title" style="margin-bottom:1.5rem;">Agregar Proyecto</h3>
      <form id="proyecto-form" method="POST">
        <input type="hidden" name="_id" id="campo-id" />
        <div style="display:grid;gap:1rem;">
          <div class="form-group">
            <label class="form-label" for="campo-nombre">Nombre del proyecto *</label>
            <input id="campo-nombre" class="form-input" type="text" name="nombre" required placeholder="Nombre del proyecto" />
          </div>
          <div class="form-group">
            <label class="form-label" for="campo-categoria">Categoría *</label>
            <select id="campo-categoria" class="form-input form-select" name="categoria_id" required>
              {categorias.filter(c => c.activa === true).map(cat => (
                <option value={cat.id}>{cat.nombre}</option>
              ))}
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="campo-descripcion">Descripción</label>
            <textarea
              id="campo-descripcion"
              class="form-input"
              name="descripcion"
              placeholder="Descripción breve del proyecto..."
              rows={3}
              style="resize:vertical;"
            ></textarea>
          </div>
          <div class="form-group">
            <label class="form-label">Integrantes del Equipo (De 1 a 3 personas)</label>
            <div style="display:flex; flex-direction:column; gap:0.5rem; margin-top:0.25rem;">
              <input id="campo-autor-1" class="form-input" type="text" placeholder="Integrante 1 (Principal) *" required />
              <input id="campo-autor-2" class="form-input" type="text" placeholder="Integrante 2 (Opcional)" />
              <input id="campo-autor-3" class="form-input" type="text" placeholder="Integrante 3 (Opcional)" />
            </div>
            <input id="campo-autores" type="hidden" name="autores" />
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-top:0.75rem;">
            <button type="button" class="btn btn--outline" style="border-radius:100px;font-weight:700;" onclick="cerrarModal()">Cancelar</button>
            <button type="submit" class="btn btn--primary" style="border-radius:100px;font-weight:700;box-shadow:0 4px 14px rgba(0, 89, 78, 0.25);" id="modal-submit-btn">Guardar</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  function abrirModal(proyecto?: any, categoriaId?: number) {
    const form = document.getElementById('proyecto-form') as HTMLFormElement;
    const title = document.getElementById('modal-title')!;
    const submitBtn = document.getElementById('modal-submit-btn')!;
    const autoresInput = (document.getElementById('campo-autores') as HTMLInputElement);
    const autor1 = document.getElementById('campo-autor-1') as HTMLInputElement;
    const autor2 = document.getElementById('campo-autor-2') as HTMLInputElement;
    const autor3 = document.getElementById('campo-autor-3') as HTMLInputElement;

    if (proyecto) {
      title.textContent = 'Editar Proyecto';
      submitBtn.textContent = 'Guardar cambios';
      form.action = `/api/admin/proyectos/${proyecto.id}?_method=PUT`;
      (document.getElementById('campo-id') as HTMLInputElement).value = proyecto.id;
      (document.getElementById('campo-nombre') as HTMLInputElement).value = proyecto.nombre;
      (document.getElementById('campo-categoria') as HTMLSelectElement).value = String(proyecto.categoria_id);
      (document.getElementById('campo-descripcion') as HTMLTextAreaElement).value = proyecto.descripcion || '';
      
      const autores = (proyecto.autores || '').split(',').map((a: string) => a.trim());
      autor1.value = autores[0] || '';
      autor2.value = autores[1] || '';
      autor3.value = autores[2] || '';
      autoresInput.value = proyecto.autores || '';
    } else {
      title.textContent = 'Nuevo Proyecto';
      submitBtn.textContent = 'Crear proyecto';
      form.action = '/api/admin/proyectos';
      form.reset();
      autor1.value = ''; autor2.value = ''; autor3.value = '';
      autoresInput.value = '';
      if (categoriaId) {
        (document.getElementById('campo-categoria') as HTMLSelectElement).value = String(categoriaId);
      }
    }

    document.getElementById('modal-overlay')!.classList.add('active');
  }

  function cerrarModal() {
    document.getElementById('modal-overlay')!.classList.remove('active');
  }

  async function eliminarProyecto(id: number, nombre: string) {
    if (!confirm(`¿Eliminar el proyecto "${nombre}"? Esta acción no se puede deshacer.`)) return;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/api/admin/proyectos/${id}?_method=DELETE`;
    document.body.appendChild(form);
    form.submit();
  }

  document.getElementById('modal-overlay')!.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) cerrarModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarModal();
  });

  document.getElementById('proyecto-form')!.addEventListener('submit', function() {
    const a1 = (document.getElementById('campo-autor-1') as HTMLInputElement).value.trim();
    const a2 = (document.getElementById('campo-autor-2') as HTMLInputElement).value.trim();
    const a3 = (document.getElementById('campo-autor-3') as HTMLInputElement).value.trim();
    const arr = [a1, a2, a3].filter(x => x.length > 0);
    (document.getElementById('campo-autores') as HTMLInputElement).value = arr.join(', ');
  });

  (window as any).abrirModal = abrirModal;
  (window as any).cerrarModal = cerrarModal;
  (window as any).eliminarProyecto = eliminarProyecto;
</script>
