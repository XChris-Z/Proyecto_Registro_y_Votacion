---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { obtenerLogs } from '@lib/db';

const session = Astro.cookies.get('admin_session')?.value;
if (!session) {
  return Astro.redirect('/admin');
}

const logsIniciales = await obtenerLogs(50);
---

<AdminLayout title="Auditoría y Logs" activePage="logs">
  <div style="max-width: 1000px; margin: 0 auto;">
    <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.25rem; color: var(--clr-text);">Logs del Sistema</h1>
        <p style="color: var(--clr-text-muted);">Monitorización en tiempo real de las acciones administrativas.</p>
      </div>
      
      <div class="badge-live" style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 0.5rem 1rem; border-radius: 100px; font-weight: 800; font-size: 0.85rem; border: 1px solid rgba(16, 185, 129, 0.3); box-shadow: 0 2px 10px rgba(16, 185, 129, 0.15);">
        <span class="pulse-dot" style="background: #10b981; box-shadow: 0 0 8px #10b981;"></span>
        EN VIVO
      </div>
    </div>

    <div class="card table-wrapper animate-fade-up" style="border: 1px solid var(--clr-border);">
      <table id="logs-table">
        <thead>
          <tr>
            <th>Fecha y Hora</th>
            <th>Administrador</th>
            <th>Acción</th>
            <th>Detalles</th>
          </tr>
        </thead>
        <tbody id="logs-tbody">
          {logsIniciales.map(log => (
            <tr data-log-id={log.id}>
              <td style="white-space: nowrap; font-size: 0.85rem; color: var(--clr-text-muted);">
                {new Date(log.fecha).toLocaleString('es-CO', { timeZone: 'America/Bogota' })}
              </td>
              <td style="font-weight: 700; color: var(--clr-text);">{log.admin_nombre}</td>
              <td>
                <span style="background: rgba(0, 89, 78, 0.15); color: var(--clr-primary); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.8rem; font-weight: 700; display: inline-block;">
                  {log.accion}
                </span>
              </td>
              <td style="font-size: 0.9rem; color: var(--clr-text);">{log.detalle || '-'}</td>
            </tr>
          ))}
          {logsIniciales.length === 0 && (
            <tr id="empty-logs-row">
              <td colspan="4" style="text-align: center; padding: 2.5rem; color: var(--clr-text-muted);">No hay registros recientes de auditoría en el sistema.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      // Limpiar intervalo anterior si existe (por navegación de cliente de Astro)
      if (window.logsInterval) clearInterval(window.logsInterval);
      
      const tbody = document.getElementById('logs-tbody');
      if (!tbody) return;

      window.logsInterval = setInterval(async () => {
        try {
          const res = await fetch('/api/admin/logs.json');
          if (!res.ok) return;
          const logs = await res.json();
          
          if (logs.length > 0) {
            const emptyRow = document.getElementById('empty-logs-row');
            if (emptyRow) emptyRow.remove();
          }

          // ID del log más reciente que tenemos
          const firstRow = tbody.querySelector('tr[data-log-id]');
          const lastId = firstRow ? parseInt(firstRow.getAttribute('data-log-id')) : 0;
          
          // Agregamos en orden de los nuevos (del más antiguo al más nuevo para prepend)
          for (let i = logs.length - 1; i >= 0; i--) {
            const log = logs[i];
            if (log.id > lastId) {
              const tr = document.createElement('tr');
              tr.setAttribute('data-log-id', log.id);
              // Destacar fila nueva con una animación y color de fondo temporal
              tr.style.animation = 'fadeInUp 0.4s ease both';
              tr.style.background = 'rgba(181, 161, 96, 0.15)'; 
              
              setTimeout(() => {
                tr.style.transition = 'background 2s ease';
                tr.style.background = 'transparent';
                setTimeout(() => tr.style.transition = '', 2000);
              }, 2500);

              const dateStr = new Date(log.fecha).toLocaleString('es-CO', { timeZone: 'America/Bogota' });
              
              tr.innerHTML = `
                <td style="white-space: nowrap; font-size: 0.85rem; color: var(--clr-text-muted);">${dateStr}</td>
                <td style="font-weight: 700; color: var(--clr-text);">${log.admin_nombre}</td>
                <td>
                  <span style="background: rgba(0, 89, 78, 0.15); color: var(--clr-primary); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.8rem; font-weight: 700; display: inline-block;">
                    ${log.accion}
                  </span>
                </td>
                <td style="font-size: 0.9rem; color: var(--clr-text);">${log.detalle || '-'}</td>
              `;
              
              tbody.prepend(tr);
            }
          }
          
          // Limitar cantidad de filas a 100 para no saturar DOM
          while (tbody.children.length > 100) {
            tbody.removeChild(tbody.lastChild);
          }
          
        } catch (e) {
          console.error("Error obteniendo logs en vivo:", e);
        }
      }, 5000);
    });
  </script>
</AdminLayout>
