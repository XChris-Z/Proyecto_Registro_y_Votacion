---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { obtenerAdministradores, obtenerAdminPorId, obtenerJurados } from '@lib/db';

const session = Astro.cookies.get('admin_session')?.value;
if (!session) {
  return Astro.redirect('/admin');
}

const currentAdmin = await obtenerAdminPorId(Number(session));
const isSuperAdmin = currentAdmin?.usuario === 'admin';

const administradores = await obtenerAdministradores();
const jurados = await obtenerJurados();
const exitoParam = Astro.url.searchParams.get('exito');
const errorParam = Astro.url.searchParams.get('error');
---

<AdminLayout title="Gestión de Usuarios" activePage="usuarios">
  <div style="max-width: 900px; margin: 0 auto;">
    <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <div>
        <h1 style="font-size: 2rem; font-weight: 800; margin-bottom: 0.25rem; color: var(--clr-text);">Usuarios del Sistema</h1>
        <p style="color: var(--clr-text-muted);">Gestiona los administradores y los jurados de evaluación.</p>
      </div>
      {isSuperAdmin && (
        <button class="btn btn--primary" onclick="abrirModalCrearUsuario()" style="padding: 0.65rem 1.4rem; font-weight: 800; border-radius: 100px; display: flex; align-items: center; gap: 0.5rem; background: var(--clr-primary); border: 2px solid var(--clr-accent);">
          <span style="font-size: 1.2rem;">+</span> Crear Usuario
        </button>
      )}
    </div>

    {exitoParam === 'user_created' && (
      <div class="alert alert--success mb-4" style="padding: 1rem;">
        <span style="font-size:1.3rem;">✅</span> Usuario creado exitosamente.
      </div>
    )}
    {errorParam === 'missing_fields' && (
      <div class="alert alert--error mb-4" style="padding: 1rem;">
        <span style="font-size:1.3rem;">⚠️</span> Todos los campos son obligatorios.
      </div>
    )}
    {errorParam === 'pass_short' && (
      <div class="alert alert--error mb-4" style="padding: 1rem;">
        <span style="font-size:1.3rem;">⚠️</span> La contraseña debe tener al menos 6 caracteres.
      </div>
    )}
    {errorParam === 'user_exists' && (
      <div class="alert alert--error mb-4" style="padding: 1rem;">
        <span style="font-size:1.3rem;">⚠️</span> El nombre de usuario o correo ya está en uso.
      </div>
    )}
    {errorParam === 'unauthorized' && (
      <div class="alert alert--error mb-4" style="padding: 1rem;">
        <span style="font-size:1.3rem;">⚠️</span> No tienes permisos de administrador principal.
      </div>
    )}
    {errorParam === 'unknown' && (
      <div class="alert alert--error mb-4" style="padding: 1rem;">
        <span style="font-size:1.3rem;">⚠️</span> Ocurrió un error inesperado.
      </div>
    )}

    <div class="card table-wrapper animate-fade-up" style="border: 1px solid var(--clr-border);">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Identificador</th>
            <th>Nombre Completo</th>
            <th>Rol / Estado</th>
            {isSuperAdmin && <th>Acciones</th>}
          </tr>
        </thead>
        <tbody>
          {administradores.map(admin => (
            <tr>
              <td style="color: var(--clr-text-muted);">#{admin.id}</td>
              <td style="font-weight: 700; color: var(--clr-text);">{admin.usuario}</td>
              <td>{admin.nombre || 'N/A'}</td>
              <td>
                <div style="display:flex; flex-direction:column; gap:0.25rem; align-items:flex-start;">
                  <span class="badge" style="background: var(--clr-primary-light); color: white; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem;">Admin</span>
                  {isSuperAdmin && admin.usuario !== 'admin' ? (
                    <form method="POST" action="/api/admin/toggle-estado" style="display:inline-block; margin:0;">
                      <input type="hidden" name="id" value={admin.id} />
                      <input type="hidden" name="estado" value={admin.activo ? 'false' : 'true'} />
                      <button type="submit" class="toggle-btn" title={admin.activo ? 'Desactivar usuario' : 'Activar usuario'} style={`border:none; cursor:pointer; padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; transition: all 0.2s ease; display: inline-flex; align-items: center; gap: 0.2rem; ${admin.activo ? 'background: rgba(16, 185, 129, 0.15); color: #059669;' : 'background: rgba(239, 68, 68, 0.15); color: #dc2626;'}`}>
                        {admin.activo ? 'Activo' : 'Inactivo'}
                      </button>
                    </form>
                  ) : (
                    <span style={`padding: 0.15rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.2rem; ${admin.activo ? 'background: rgba(16, 185, 129, 0.15); color: #059669;' : 'background: rgba(239, 68, 68, 0.15); color: #dc2626;'}`}>
                      {admin.activo ? 'Activo' : 'Inactivo'}
                    </span>
                  )}
                </div>
              </td>
              {isSuperAdmin && (
                <td>
                  {admin.usuario !== 'admin' ? (
                    <div style="display:flex; gap:0.5rem;">
                      <button type="button" class="btn btn--outline" onclick={`abrirModalEditarUsuario(${admin.id}, '${admin.usuario}', '${admin.nombre}')`} style="padding:0.3rem 0.7rem; font-size:0.8rem; border-radius:6px;" title="Editar">
                        ✏️ Editar
                      </button>
                      <form method="POST" action={`/api/admin/usuarios/${admin.id}?_method=DELETE`} style="margin:0;" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este usuario permanentemente?');">
                        <button type="submit" class="btn btn--outline" style="padding:0.3rem 0.7rem; font-size:0.8rem; border-radius:6px; color:var(--clr-error); border-color:var(--clr-error);" title="Eliminar">
                          🗑️ Eliminar
                        </button>
                      </form>
                    </div>
                  ) : (
                    <span style="color:var(--clr-text-muted); font-size:0.85rem; font-style:italic;">Super Admin</span>
                  )}
                </td>
              )}
            </tr>
          ))}

          {jurados.map(jurado => (
            <tr>
              <td style="color: var(--clr-text-muted); font-size:0.75rem;" title={jurado.id}>...{jurado.id.slice(-6)}</td>
              <td style="font-weight: 700; color: var(--clr-text);">{jurado.email || 'N/A'}</td>
              <td>{jurado.nombre_completo || 'N/A'}</td>
              <td>
                <span class="badge" style="background: var(--clr-accent); color: #1a1a1a; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight:700;">Jurado</span>
              </td>
              {isSuperAdmin && (
                <td>
                  <div style="display:flex; gap:0.5rem;">
                    <button type="button" class="btn btn--outline" onclick={`abrirModalEditarJurado('${jurado.id}', '${jurado.email}', '${jurado.nombre_completo}')`} style="padding:0.3rem 0.7rem; font-size:0.8rem; border-radius:6px;" title="Editar">
                      ✏️ Editar
                    </button>
                    <form method="POST" action={`/api/admin/jurados/${jurado.id}?_method=DELETE`} style="margin:0;" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este jurado permanentemente?');">
                      <button type="submit" class="btn btn--outline" style="padding:0.3rem 0.7rem; font-size:0.8rem; border-radius:6px; color:var(--clr-error); border-color:var(--clr-error);" title="Eliminar">
                        🗑️ Eliminar
                      </button>
                    </form>
                  </div>
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Crear Usuario -->
  <div class="modal-overlay" id="modal-crear-usuario" onclick="cerrarModalCrearUsuario(event)">
    <div class="modal card" style="max-width: 460px; width: 95%; border: 2px solid #B5A160; background: var(--clr-bg); padding: 2rem;" onclick="event.stopPropagation()">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;border-bottom:1px solid var(--clr-border);padding-bottom:1rem;">
        <h3 style="font-size:1.2rem;font-weight:800;color:var(--clr-text);margin:0;display:flex;align-items:center;gap:0.5rem;">
          <span>👤</span> Nuevo Usuario
        </h3>
        <button type="button" onclick="cerrarModalCrearUsuario()" style="background:none;border:none;font-size:1.5rem;color:var(--clr-text-muted);cursor:pointer;">✕</button>
      </div>

      <form method="POST" action="/api/admin/crear-usuario">
        <div class="form-group mb-3">
          <label class="form-label" for="rol">Rol del Usuario <span style="color:var(--clr-error);">*</span></label>
          <select id="rol" name="rol" class="form-input" style="width:100%;border-radius:100px;padding:0.75rem 1.25rem; cursor:pointer;" onchange="toggleRolFields()">
            <option value="admin">Administrador</option>
            <option value="jurado">Jurado de Votación</option>
          </select>
        </div>

        <div class="form-group mb-3">
          <label class="form-label" for="nombre">Nombre Completo <span style="color:var(--clr-error);">*</span></label>
          <input
            id="nombre"
            name="nombre"
            class="form-input"
            type="text"
            placeholder="Ej. Juan Pérez"
            required
            style="width:100%;border-radius:100px;padding:0.75rem 1.25rem;"
          />
        </div>

        <div class="form-group mb-3" id="campo-usuario">
          <label class="form-label" for="usuario">Nombre de Usuario <span style="color:var(--clr-error);">*</span></label>
          <input
            id="usuario"
            name="usuario"
            class="form-input"
            type="text"
            placeholder="Ej. juanp"
            style="width:100%;border-radius:100px;padding:0.75rem 1.25rem;"
          />
        </div>

        <div class="form-group mb-3 hidden" id="campo-email">
          <label class="form-label" for="email">Correo Electrónico <span style="color:var(--clr-error);">*</span></label>
          <input
            id="email"
            name="email"
            class="form-input"
            type="email"
            placeholder="ejemplo@correo.com"
            style="width:100%;border-radius:100px;padding:0.75rem 1.25rem;"
          />
        </div>

        <div class="form-group mb-4">
          <label class="form-label" for="password">Contraseña <span style="color:var(--clr-error);">*</span></label>
          <div style="position:relative;">
            <input
              id="password"
              name="password"
              class="form-input"
              type="password"
              placeholder="Mínimo 6 caracteres"
              required
              minlength="6"
              style="width:100%;border-radius:100px;padding:0.75rem 3rem 0.75rem 1.25rem;"
            />
            <button type="button" class="toggle-pwd-btn" onclick="togglePasswordVisibility('password', this)" style="position:absolute; right:1rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; font-size:1.1rem; opacity:0.7;">👁️</button>
          </div>
        </div>

        <div style="display:flex;gap:0.85rem;justify-content:flex-end;">
          <button type="button" class="btn btn--outline" onclick="cerrarModalCrearUsuario()" style="border-radius:100px;padding:0.65rem 1.3rem;font-weight:700;">Cancelar</button>
          <button type="submit" class="btn btn--primary" style="border-radius:100px;padding:0.65rem 1.5rem;font-weight:800;background:var(--clr-primary);border-color:var(--clr-accent);">Crear Usuario</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Editar Usuario (Solo para Admins) -->
  <div class="modal-overlay" id="modal-editar-usuario" onclick="cerrarModalEditarUsuario(event)">
    <div class="modal card" style="max-width: 460px; width: 95%; border: 2px solid #B5A160; background: var(--clr-bg); padding: 2rem;" onclick="event.stopPropagation()">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;border-bottom:1px solid var(--clr-border);padding-bottom:1rem;">
        <h3 style="font-size:1.2rem;font-weight:800;color:var(--clr-text);margin:0;display:flex;align-items:center;gap:0.5rem;">
          <span>✏️</span> Editar Administrador
        </h3>
        <button type="button" onclick="cerrarModalEditarUsuario()" style="background:none;border:none;font-size:1.5rem;color:var(--clr-text-muted);cursor:pointer;">✕</button>
      </div>

      <form method="POST" id="form-editar-usuario" action="">
        <div class="form-group mb-3">
          <label class="form-label" for="edit_nombre">Nombre Completo <span style="color:var(--clr-error);">*</span></label>
          <input
            id="edit_nombre"
            name="nombre"
            class="form-input"
            type="text"
            required
            style="width:100%;border-radius:100px;padding:0.75rem 1.25rem;"
          />
        </div>

        <div class="form-group mb-3">
          <label class="form-label" for="edit_usuario">Nombre de Usuario <span style="color:var(--clr-error);">*</span></label>
          <input
            id="edit_usuario"
            name="usuario"
            class="form-input"
            type="text"
            required
            style="width:100%;border-radius:100px;padding:0.75rem 1.25rem;"
          />
        </div>

        <div class="form-group mb-4">
          <label class="form-label" for="edit_password">Nueva Contraseña <span style="color:var(--clr-text-muted); font-weight: normal; font-size: 0.85rem;">(Opcional)</span></label>
          <div style="position:relative;">
            <input
              id="edit_password"
              name="password"
              class="form-input"
              type="password"
              placeholder="Dejar en blanco para mantener la actual"
              minlength="6"
              style="width:100%;border-radius:100px;padding:0.75rem 3rem 0.75rem 1.25rem;"
            />
            <button type="button" class="toggle-pwd-btn" onclick="togglePasswordVisibility('edit_password', this)" style="position:absolute; right:1rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; font-size:1.1rem; opacity:0.7;">👁️</button>
          </div>
        </div>

        <div style="display:flex;gap:0.85rem;justify-content:flex-end;">
          <button type="button" class="btn btn--outline" onclick="cerrarModalEditarUsuario()" style="border-radius:100px;padding:0.65rem 1.3rem;font-weight:700;">Cancelar</button>
          <button type="submit" class="btn btn--primary" style="border-radius:100px;padding:0.65rem 1.5rem;font-weight:800;background:var(--clr-primary);border-color:var(--clr-accent);">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Editar Jurado (Solo para Admins) -->
  <div class="modal-overlay" id="modal-editar-jurado" onclick="cerrarModalEditarJurado(event)">
    <div class="modal card" style="max-width: 460px; width: 95%; border: 2px solid #B5A160; background: var(--clr-bg); padding: 2rem;" onclick="event.stopPropagation()">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;border-bottom:1px solid var(--clr-border);padding-bottom:1rem;">
        <h3 style="font-size:1.2rem;font-weight:800;color:var(--clr-text);margin:0;display:flex;align-items:center;gap:0.5rem;">
          <span>✏️</span> Editar Jurado
        </h3>
        <button type="button" onclick="cerrarModalEditarJurado()" style="background:none;border:none;font-size:1.5rem;color:var(--clr-text-muted);cursor:pointer;">✕</button>
      </div>

      <form method="POST" id="form-editar-jurado" action="">
        <div class="form-group mb-3">
          <label class="form-label" for="edit_jurado_nombre">Nombre Completo <span style="color:var(--clr-error);">*</span></label>
          <input
            id="edit_jurado_nombre"
            name="nombre"
            class="form-input"
            type="text"
            required
            style="width:100%;border-radius:100px;padding:0.75rem 1.25rem;"
          />
        </div>

        <div class="form-group mb-3">
          <label class="form-label" for="edit_jurado_email">Correo Electrónico <span style="color:var(--clr-error);">*</span></label>
          <input
            id="edit_jurado_email"
            name="email"
            class="form-input"
            type="email"
            required
            style="width:100%;border-radius:100px;padding:0.75rem 1.25rem;"
          />
        </div>

        <div class="form-group mb-4">
          <label class="form-label" for="edit_jurado_password">Nueva Contraseña <span style="color:var(--clr-text-muted); font-weight: normal; font-size: 0.85rem;">(Opcional)</span></label>
          <div style="position:relative;">
            <input
              id="edit_jurado_password"
              name="password"
              class="form-input"
              type="password"
              placeholder="Dejar en blanco para mantener la actual"
              minlength="6"
              style="width:100%;border-radius:100px;padding:0.75rem 3rem 0.75rem 1.25rem;"
            />
            <button type="button" class="toggle-pwd-btn" onclick="togglePasswordVisibility('edit_jurado_password', this)" style="position:absolute; right:1rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; font-size:1.1rem; opacity:0.7;">👁️</button>
          </div>
        </div>

        <div style="display:flex;gap:0.85rem;justify-content:flex-end;">
          <button type="button" class="btn btn--outline" onclick="cerrarModalEditarJurado()" style="border-radius:100px;padding:0.65rem 1.3rem;font-weight:700;">Cancelar</button>
          <button type="submit" class="btn btn--primary" style="border-radius:100px;padding:0.65rem 1.5rem;font-weight:800;background:var(--clr-primary);border-color:var(--clr-accent);">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>

  <script is:inline>
    function toggleRolFields() {
      const rol = document.getElementById('rol')?.value;
      const campoUsuario = document.getElementById('campo-usuario');
      const campoEmail = document.getElementById('campo-email');
      const inputUsuario = document.getElementById('usuario');
      const inputEmail = document.getElementById('email');

      if (!campoUsuario || !campoEmail) return;

      if (rol === 'jurado') {
        campoUsuario.classList.add('hidden');
        inputUsuario?.removeAttribute('required');
        campoEmail.classList.remove('hidden');
        inputEmail?.setAttribute('required', 'true');
      } else {
        campoEmail.classList.add('hidden');
        inputEmail?.removeAttribute('required');
        campoUsuario.classList.remove('hidden');
        inputUsuario?.setAttribute('required', 'true');
      }
    }
    
    // Llamar al cargar para establecer estado inicial
    setTimeout(toggleRolFields, 50);

    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      if (input) {
        if (input.type === 'password') {
          input.type = 'text';
          btn.textContent = '🙈';
        } else {
          input.type = 'password';
          btn.textContent = '👁️';
        }
      }
    }

    window.abrirModalCrearUsuario = function() {
      const modal = document.getElementById('modal-crear-usuario');
      if (modal) modal.classList.add('active');
    };

    window.cerrarModalCrearUsuario = function(e) {
      const modal = document.getElementById('modal-crear-usuario');
      if (modal) {
        if (!e || e.target === modal || e.type === 'click' && !e.target.closest('.modal')) {
          modal.classList.remove('active');
        }
      }
    };

    window.abrirModalEditarUsuario = function(id, usuario, nombre) {
      const modal = document.getElementById('modal-editar-usuario');
      const form = document.getElementById('form-editar-usuario');
      document.getElementById('edit_usuario').value = usuario;
      document.getElementById('edit_nombre').value = nombre;
      document.getElementById('edit_password').value = '';
      form.action = `/api/admin/usuarios/${id}?_method=PUT`;
      if (modal) modal.classList.add('active');
    };

    window.cerrarModalEditarUsuario = function(e) {
      const modal = document.getElementById('modal-editar-usuario');
      if (modal) {
        if (!e || e.target === modal || e.type === 'click' && !e.target.closest('.modal')) {
          modal.classList.remove('active');
        }
      }
    };

    window.abrirModalEditarJurado = function(id, email, nombre) {
      const modal = document.getElementById('modal-editar-jurado');
      const form = document.getElementById('form-editar-jurado');
      document.getElementById('edit_jurado_email').value = email;
      document.getElementById('edit_jurado_nombre').value = nombre;
      document.getElementById('edit_jurado_password').value = '';
      form.action = `/api/admin/jurados/${id}?_method=PUT`;
      if (modal) modal.classList.add('active');
    };

    window.cerrarModalEditarJurado = function(e) {
      const modal = document.getElementById('modal-editar-jurado');
      if (modal) {
        if (!e || e.target === modal || e.type === 'click' && !e.target.closest('.modal')) {
          modal.classList.remove('active');
        }
      }
    };
  </script>
</AdminLayout>

<style>
  .toggle-btn:hover {
    filter: brightness(0.95);
    transform: scale(1.02);
  }
  .hidden {
    display: none !important;
  }
</style>
