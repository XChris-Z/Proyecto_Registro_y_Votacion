---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { obtenerCriteriosEvaluacion } from '@lib/db';

const criterios = await obtenerCriteriosEvaluacion();
const msg = Astro.url.searchParams.get('msg') || Astro.url.searchParams.get('success');
const errorMsg = Astro.url.searchParams.get('error');
---

<AdminLayout title="Criterios de Evaluación" activePage="criterios">
  <div style="max-width:900px;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:2rem;">
      <div>
        <h1 style="font-size:2rem;font-weight:800;margin-bottom:0.25rem;color:var(--clr-text);">Criterios de Evaluación</h1>
        <p style="color:var(--clr-text-muted);">Gestiona los criterios con los que los jurados calificarán los proyectos</p>
      </div>
      <button class="btn btn--primary" style="border-radius:100px;padding:0.65rem 1.4rem;font-weight:700;box-shadow:0 4px 14px rgba(0, 89, 78, 0.25);" onclick="abrirModal()">+ Nuevo criterio</button>
    </div>

    {msg && <div class="alert alert--success mb-3"><span>✅</span> Operación realizada con éxito</div>}
    {errorMsg && <div class="alert alert--error mb-3" style="color: red;"><span>❌</span> {errorMsg}</div>}

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Peso (%)</th>
            <th style="text-align:right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {criterios.map(crit => (
            <tr>
              <td style="color:var(--clr-text-muted);font-size:0.85rem;font-weight:700;">#{crit.id}</td>
              <td style="font-weight:700;color:var(--clr-text);">{crit.nombre}</td>
              <td style="color:var(--clr-text-muted);font-size:0.85rem;max-width:350px;">
                {crit.descripcion || <span style="color:var(--clr-text-dim);">—</span>}
              </td>
              <td style="font-weight:700;color:var(--clr-accent);">
                {crit.peso_porcentual ? `${crit.peso_porcentual}%` : <span style="color:var(--clr-text-dim);">N/A</span>}
              </td>
              <td style="text-align:right;">
                <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
                  <button class="btn btn--outline btn--sm" style="border-radius:100px;padding:0.35rem 0.95rem;font-weight:700;" onclick={`abrirModal(${JSON.stringify(crit)})`}>Editar</button>
                  <button class="btn btn--danger btn--sm" style="border-radius:100px;padding:0.35rem 0.95rem;font-weight:700;" onclick={`eliminarCriterio(${crit.id}, '${crit.nombre.replace(/'/g, "\\'")}')`}>Eliminar</button>
                </div>
              </td>
            </tr>
          ))}
          {criterios.length === 0 && (
            <tr>
              <td colspan={5} style="text-align:center;color:var(--clr-text-dim);padding:2rem;">
                No hay criterios de evaluación creados.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal -->
  <div class="modal-overlay" id="modal-overlay" onclick="if(event.target === this) cerrarModal()">
    <div class="modal card" style="max-width: 500px; width: 95%; border: 2px solid #B5A160; background: var(--clr-bg); padding: 2rem;">
      <h3 id="modal-title" style="margin-bottom:1.5rem; font-size: 1.5rem;">Nuevo Criterio</h3>
      <form id="crit-form" method="POST" action="/api/admin/criterios">
        <input type="hidden" name="action" id="campo-action" value="update" />
        <div style="display:grid;gap:1rem;">
          <div class="form-group">
            <label class="form-label" for="campo-nombre">Nombre del Criterio *</label>
            <input id="campo-nombre" class="form-input" type="text" name="nombre" required placeholder="Ej. Innovación" />
          </div>
          <div class="form-group">
            <label class="form-label" for="campo-desc">Descripción (Guía para el jurado)</label>
            <textarea id="campo-desc" class="form-input" name="descripcion" placeholder="Explica qué se evalúa en este criterio" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label class="form-label" for="campo-peso">Peso Porcentual (Opcional, %)</label>
            <input id="campo-peso" class="form-input" type="number" step="0.1" min="0" max="100" name="peso_porcentual" placeholder="Ej. 25" />
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-top:1rem;">
            <button type="button" class="btn btn--outline" style="border-radius:100px;font-weight:700;" onclick="cerrarModal()">Cancelar</button>
            <button type="submit" id="submit-btn" class="btn btn--primary" style="border-radius:100px;font-weight:700;box-shadow:0 4px 14px rgba(0, 89, 78, 0.25);">Guardar</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  function abrirModal(crit) {
    const form = document.getElementById('crit-form');
    const title = document.getElementById('modal-title');
    const submitBtn = document.getElementById('submit-btn');

    if (crit) {
      title.textContent = 'Editar Criterio';
      submitBtn.textContent = 'Guardar cambios';
      form.action = `/api/admin/criterios/${crit.id}`;
      document.getElementById('campo-action').value = 'update';
      document.getElementById('campo-nombre').value = crit.nombre;
      document.getElementById('campo-desc').value = crit.descripcion || '';
      document.getElementById('campo-peso').value = crit.peso_porcentual || '';
    } else {
      title.textContent = 'Nuevo Criterio';
      submitBtn.textContent = 'Crear criterio';
      form.action = '/api/admin/criterios';
      form.reset();
      document.getElementById('campo-action').value = 'create';
    }

    document.getElementById('modal-overlay').classList.add('active');
  }

  function cerrarModal() {
    document.getElementById('modal-overlay').classList.remove('active');
  }

  function eliminarCriterio(id, nombre) {
    if (!confirm(`¿Estás seguro de que deseas eliminar el criterio "${nombre}"? Los votos asociados a este criterio podrían verse afectados.`)) return;
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = `/api/admin/criterios/${id}`;
    
    const inputAction = document.createElement('input');
    inputAction.type = 'hidden';
    inputAction.name = 'action';
    inputAction.value = 'delete';
    form.appendChild(inputAction);

    document.body.appendChild(form);
    form.submit();
  }
</script>
