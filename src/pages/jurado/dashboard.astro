---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase, obtenerPerfil, obtenerProyectos, obtenerCriteriosEvaluacion, obtenerProyectosVotadosPorJurado } from '../../lib/db';

const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
  return Astro.redirect('/jurado/login');
}

// Validar token y obtener usuario
const { data: { user }, error } = await supabase.auth.getUser(accessToken);

if (error || !user) {
  return Astro.redirect('/jurado/login');
}

// Validar que el rol sea jurado
const perfil = await obtenerPerfil(user.id);
if (!perfil || perfil.rol !== 'jurado') {
  return Astro.redirect('/unauthorized'); // o redirigir al home
}

const proyectos = await obtenerProyectos();
const criterios = await obtenerCriteriosEvaluacion();
const proyectosVotados = await obtenerProyectosVotadosPorJurado(user.id);

const nombreJurado = perfil.nombre_completo || user.email;
---

<MainLayout title="Panel de Evaluación">
  <div class="container section fade-in">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
      <h2 class="text-gradient" style="margin: 0;">Panel de Evaluación</h2>
      <div style="display: flex; align-items: center; gap: 1rem;">
        <span class="text-sm" style="color: var(--color-text-light);">Bienvenido, <strong style="color: var(--clr-text);">{nombreJurado}</strong></span>
        <a href="/api/jurado/logout" class="btn btn--outline btn--sm">Cerrar sesión</a>
      </div>
    </div>

    <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
      <h3 style="margin-bottom: 1rem;">Proyectos Disponibles</h3>
      <p class="text-sm" style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        Selecciona un proyecto para evaluarlo según los criterios establecidos. Puedes usar decimales (ej. 8.5) para mayor precisión en tu calificación.
      </p>

      {proyectos.length === 0 ? (
        <p class="text-center" style="color: var(--clr-text-muted);">No hay proyectos activos en este momento.</p>
      ) : (
        <div style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
          {proyectos.map((proyecto) => {
            const yaVotado = proyectosVotados.includes(proyecto.id);
            return (
              <div class="card" style="padding: 1.5rem; border: 1px solid var(--clr-border); background: var(--clr-surface); display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                  <h4 style="margin-bottom: 0.5rem; font-size: 1.1rem;">{proyecto.nombre}</h4>
                  <span class="badge" style="background: var(--clr-primary-light); color: #fff; font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 4px; display: inline-block; margin-bottom: 0.5rem;">
                    {proyecto.categoria_nombre}
                  </span>
                  {proyecto.autores && <p class="text-sm" style="color: var(--color-text-light); line-height: 1.4;">Autores: {proyecto.autores}</p>}
                </div>
                <div style="margin-top: 1.5rem;">
                  {yaVotado ? (
                    <button class="btn btn--outline btn--full" disabled style="opacity: 0.7; cursor: not-allowed;">
                      ✅ Evaluado
                    </button>
                  ) : (
                    <button class="btn btn--primary btn--full btn-evaluar" data-id={proyecto.id} data-nombre={proyecto.nombre}>
                      Evaluar Proyecto
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Modal de Evaluación -->
  <div id="evaluacion-modal" class="modal-overlay">
    <div class="modal-content card fade-in" style="max-width: 500px; width: 95%; max-height: 90vh; display: flex; flex-direction: column;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem;">
        <h3 id="modal-proyecto-nombre" style="margin: 0; line-height: 1.3;">Evaluando...</h3>
        <button id="close-modal-btn" style="background: none; border: none; font-size: 1.8rem; cursor: pointer; color: var(--clr-text); line-height: 1;">&times;</button>
      </div>

      <form id="evaluacion-form" style="display: flex; flex-direction: column; overflow: hidden;">
        <input type="hidden" id="proyecto_id" name="proyecto_id" />
        
        <div style="overflow-y: auto; padding-right: 0.5rem; margin-bottom: 1.5rem;">
          {criterios.map((criterio) => (
            <div class="form-group" style="margin-bottom: 1.2rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--clr-border);">
              <label class="form-label" style="display: flex; justify-content: space-between; font-weight: 600;">
                <span>{criterio.nombre} {criterio.peso_porcentual && `(${criterio.peso_porcentual}%)`}</span>
              </label>
              <p class="text-sm" style="color: var(--color-text-light); margin-bottom: 0.8rem; line-height: 1.4;">{criterio.descripcion}</p>
              
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <input 
                  type="number" 
                  name={`criterio_${criterio.id}`} 
                  class="form-input" 
                  min="0" max="10" step="0.1" 
                  placeholder="0-10" 
                  required 
                  style="width: 100px; padding: 0.75rem; font-size: 1.1rem; text-align: center; border-radius: 12px;"
                />
                <span style="font-weight: 700; color: var(--clr-text-muted); font-size: 1.2rem;">/ 10</span>
              </div>
            </div>
          ))}
        </div>

        <div style="margin-top: auto;">
          <p id="eval-error" class="text-sm" style="color: var(--color-danger); display: none; margin-bottom: 1rem; text-align: center; font-weight: 500;"></p>
          <button type="submit" id="submit-eval-btn" class="btn btn--primary btn--full" style="padding: 1rem; font-size: 1.05rem;">
            Enviar Evaluación
          </button>
        </div>
      </form>
    </div>
  </div>

  <style>
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.65);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      backdrop-filter: blur(5px);
    }
    .modal-content {
      padding: 2rem;
      position: relative;
    }
    .modal-content {
      padding: 2rem;
      position: relative;
    }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      const modal = document.getElementById('evaluacion-modal');
      const closeBtn = document.getElementById('close-modal-btn');
      const form = document.getElementById('evaluacion-form') as HTMLFormElement;
      const proyectoNombre = document.getElementById('modal-proyecto-nombre');
      const proyectoIdInput = document.getElementById('proyecto_id') as HTMLInputElement;
      const evalError = document.getElementById('eval-error');
      const submitBtn = document.getElementById('submit-eval-btn') as HTMLButtonElement;

      // Abrir modal
    document.querySelectorAll('.btn-evaluar').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-id');
        const nombre = target.getAttribute('data-nombre');
        
        if (id && nombre && proyectoNombre && proyectoIdInput && modal) {
          proyectoNombre.textContent = `Evaluando: ${nombre}`;
          proyectoIdInput.value = id;
          form.reset();
          if(evalError) evalError.style.display = 'none';
          modal.classList.add('active');
        }
      });
    });

    // Cerrar modal
    closeBtn?.addEventListener('click', () => {
      modal?.classList.remove('active');
    });

    // Cerrar clickeando afuera
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('active');
      }
    });

    // Enviar formulario
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if(evalError) evalError.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/jurado/votar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
          // Recargar página para actualizar estado a "Evaluado"
          window.location.reload();
        } else {
          throw new Error(result.error || 'Error desconocido al procesar la evaluación.');
        }
      } catch (err: any) {
        if (evalError) {
          evalError.textContent = err.message;
          evalError.style.display = 'block';
        }
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar Evaluación';
      }
    });
    });
  </script>
</MainLayout>
