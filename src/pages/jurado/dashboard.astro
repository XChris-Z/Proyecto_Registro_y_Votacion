---
import MainLayout from '../../layouts/MainLayout.astro';
import { supabase, obtenerPerfil, obtenerProyectos, obtenerCriteriosEvaluacion, obtenerProyectosVotadosPorJurado } from '../../lib/db';

const accessToken = Astro.cookies.get('sb-access-token')?.value;

if (!accessToken) {
  return Astro.redirect('/jurado/login');
}

// Validar token y obtener usuario
const { data: { user }, error } = await supabase.auth.getUser(accessToken);

if (error || !user) {
  return Astro.redirect('/jurado/login');
}

// Validar que el rol sea jurado
const perfil = await obtenerPerfil(user.id);
if (!perfil || perfil.rol !== 'jurado') {
  return Astro.redirect('/unauthorized'); // o redirigir al home
}

const proyectos = await obtenerProyectos();
const criterios = await obtenerCriteriosEvaluacion();
const proyectosVotados = await obtenerProyectosVotadosPorJurado(user.id);

const nombreJurado = perfil.nombre_completo || user.email;
---

<MainLayout title="Panel de Evaluación">
  <div class="container section fade-in">
    
    <!-- HEADER ESTILIZADO -->
    <div class="dashboard-header">
      <div>
        <h2 class="text-gradient" style="margin: 0; font-size: 2.2rem; font-weight: 900; letter-spacing: -0.02em;">Panel de Evaluación</h2>
        <p style="color: var(--clr-text-muted); margin: 0.5rem 0 0 0; font-size: 0.95rem;">
          Explora los proyectos, analízalos y emite tu calificación con criterio.
        </p>
      </div>
      <div style="display: flex; align-items: center; gap: 1.25rem; background: var(--clr-surface-hover); padding: 0.75rem 1.25rem; border-radius: 100px; border: 1px solid var(--clr-border);">
        <div style="display: flex; flex-direction: column; text-align: right;">
          <span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--clr-text-dim); font-weight: 700;">Sesión activa</span>
          <span style="font-size: 0.95rem; font-weight: 700; color: var(--clr-text);">{nombreJurado}</span>
        </div>
        <div style="width: 1px; height: 30px; background: var(--clr-border);"></div>
        <a href="/api/jurado/logout" class="btn btn--danger btn--sm" style="border-radius: 100px; padding: 0.4rem 1rem; font-weight: 700;">Salir</a>
      </div>
    </div>

    <!-- TARJETAS DE PROYECTOS -->
    <div style="margin-bottom: 2rem;">
      <h3 style="margin-bottom: 1.5rem; font-size: 1.5rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-size: 1.2rem;">📂</span> Proyectos Disponibles
      </h3>

      {proyectos.length === 0 ? (
        <div style="text-align: center; padding: 4rem 2rem; background: var(--clr-surface); border-radius: 16px; border: 1px dashed var(--clr-border);">
          <span style="font-size: 3rem; opacity: 0.5; display: block; margin-bottom: 1rem;">📭</span>
          <p style="color: var(--clr-text-muted); font-size: 1.1rem; margin: 0;">No hay proyectos activos en este momento.</p>
        </div>
      ) : (
        <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">
          {proyectos.map((proyecto) => {
            const yaVotado = proyectosVotados.includes(proyecto.id);
            return (
              <div class={`project-card ${yaVotado ? 'voted' : ''}`}>
                <div>
                  <span class="badge-category">{proyecto.categoria_nombre}</span>
                  <h4 class="card-title">{proyecto.nombre}</h4>
                  {proyecto.autores && (
                    <div class="card-authors">
                      <span style="font-size: 1rem;">👥</span>
                      <span>{proyecto.autores}</span>
                    </div>
                  )}
                </div>
                <div style="margin-top: 1.5rem;">
                  {yaVotado ? (
                    <button class="btn btn--outline btn--full btn-evaluated" disabled>
                      <span>✅</span> Evaluado exitosamente
                    </button>
                  ) : (
                    <button class="btn btn--primary btn--full btn-evaluar btn-eval-hover" data-id={proyecto.id} data-nombre={proyecto.nombre} style="border-radius: 12px; font-weight: 800; padding: 0.85rem; display: flex; justify-content: center; align-items: center; gap: 0.5rem;">
                      <span>📝</span> Comenzar Evaluación
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>

  <!-- Modal de Evaluación -->
  <div id="evaluacion-modal" class="modal-overlay">
    <div class="modal-content card fade-in" style="max-width: 550px; width: 95%; max-height: 90vh; display: flex; flex-direction: column; padding: 0; overflow: hidden; border: 1px solid rgba(181, 161, 96, 0.3); box-shadow: 0 24px 48px rgba(0,0,0,0.5);">
      
      <!-- Modal Header -->
      <div style="background: var(--clr-surface-hover); padding: 1.5rem 2rem; border-bottom: 1px solid var(--clr-border); display: flex; justify-content: space-between; align-items: center;">
        <div>
          <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--clr-accent); font-weight: 800; display: block; margin-bottom: 0.25rem;">Evaluando Proyecto</span>
          <h3 id="modal-proyecto-nombre" style="margin: 0; line-height: 1.3; font-size: 1.4rem; color: var(--clr-text);">Nombre del Proyecto</h3>
        </div>
        <button id="close-modal-btn" style="background: var(--clr-surface); border: 1px solid var(--clr-border); width: 36px; height: 36px; border-radius: 50%; font-size: 1.2rem; cursor: pointer; color: var(--clr-text-muted); display: flex; align-items: center; justify-content: center; transition: all 0.2s;">✕</button>
      </div>

      <form id="evaluacion-form" style="display: flex; flex-direction: column; overflow: hidden; flex: 1;">
        <input type="hidden" id="proyecto_id" name="proyecto_id" />
        
        <div class="modal-body custom-scrollbar" style="overflow-y: auto; padding: 2rem;">
          <div style="background: rgba(181, 161, 96, 0.08); border: 1px solid rgba(181, 161, 96, 0.2); border-radius: 12px; padding: 1rem; margin-bottom: 2rem; display: flex; gap: 0.75rem; align-items: flex-start;">
            <span style="font-size: 1.25rem;">💡</span>
            <p style="margin: 0; font-size: 0.85rem; color: var(--clr-text-muted); line-height: 1.5;">
              Asigna una calificación del <strong>0 al 10</strong> para cada criterio. Puedes usar decimales (ej: 8.5) para mayor precisión. Todos los campos son obligatorios.
            </p>
          </div>

          {criterios.map((criterio) => (
            <div class="form-group" style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--clr-border);">
              <label class="form-label" style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.5rem; color: var(--clr-text);">
                <span>{criterio.nombre}</span>
                {criterio.peso_porcentual && (
                  <span style="background: var(--clr-surface); border: 1px solid var(--clr-border); padding: 0.15rem 0.5rem; border-radius: 100px; font-size: 0.75rem; color: var(--clr-accent);">{criterio.peso_porcentual}% del total</span>
                )}
              </label>
              <p class="text-sm" style="color: var(--clr-text-dim); margin-bottom: 1rem; line-height: 1.5;">{criterio.descripcion}</p>
              
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <input 
                  type="number" 
                  name={`criterio_${criterio.id}`} 
                  class="form-input criteria-input" 
                  min="0" max="10" step="0.1" 
                  placeholder="0.0" 
                  required 
                  style="width: 100px; padding: 0.85rem; font-size: 1.2rem; font-weight: 800; text-align: center; border-radius: 12px; border: 2px solid var(--clr-border); background: var(--clr-bg); color: var(--clr-text);"
                />
                <span style="font-weight: 800; color: var(--clr-text-dim); font-size: 1.2rem;">/ 10</span>
              </div>
            </div>
          ))}
        </div>

        <div style="padding: 1.5rem 2rem; border-top: 1px solid var(--clr-border); background: var(--clr-bg);">
          <p id="eval-error" class="text-sm" style="color: var(--color-danger); display: none; margin-bottom: 1rem; text-align: center; font-weight: 600; padding: 0.5rem; background: rgba(255, 68, 68, 0.1); border-radius: 8px;"></p>
          <button type="submit" id="submit-eval-btn" class="btn btn--primary btn--full" style="padding: 1.1rem; font-size: 1.1rem; border-radius: 14px; font-weight: 800; box-shadow: 0 8px 24px rgba(0, 89, 78, 0.25);">
            Confirmar y Enviar Evaluación
          </button>
        </div>
      </form>
    </div>
  </div>

  <style>
    /* Estilos del Header */
    .dashboard-header {
      background: var(--clr-surface);
      border: 1px solid var(--clr-border);
      border-radius: 20px;
      padding: 2.5rem;
      margin-bottom: 3rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
      box-shadow: 0 12px 40px rgba(0,0,0,0.08);
      position: relative;
      overflow: hidden;
    }
    
    .dashboard-header::after {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, var(--clr-primary-light) 0%, transparent 70%);
      opacity: 0.15;
      border-radius: 50%;
      pointer-events: none;
    }

    /* Tarjetas de Proyectos */
    .project-card {
      background: var(--clr-surface);
      border: 1px solid var(--clr-border);
      border-radius: 20px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      position: relative;
    }
    
    .project-card:not(.voted):hover {
      transform: translateY(-6px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
      border-color: var(--clr-accent);
      background: var(--clr-surface-hover);
    }

    .project-card.voted {
      opacity: 0.8;
      border-color: var(--clr-primary);
      background: var(--clr-surface-hover);
    }

    .badge-category {
      background: var(--clr-surface-hover);
      color: var(--clr-accent);
      border: 1px solid var(--clr-border);
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.35rem 0.75rem;
      border-radius: 100px;
      display: inline-block;
      margin-bottom: 1.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    
    .card-title {
      font-size: 1.35rem;
      font-weight: 800;
      margin-bottom: 0.75rem;
      color: var(--clr-text);
      line-height: 1.3;
      letter-spacing: -0.01em;
    }

    .card-authors {
      font-size: 0.88rem;
      color: var(--clr-text-muted);
      line-height: 1.5;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      background: var(--clr-surface-hover);
      padding: 0.75rem 1rem;
      border-radius: 12px;
    }

    /* Botones específicos de tarjeta */
    .btn-eval-hover {
      transition: all 0.25s ease;
    }
    .project-card:not(.voted):hover .btn-eval-hover {
      background: var(--clr-primary-light);
      box-shadow: 0 4px 15px rgba(0, 89, 78, 0.4);
      transform: scale(1.02);
    }

    .btn-evaluated {
      border-radius: 12px;
      font-weight: 700;
      padding: 0.85rem;
      border-color: rgba(0, 89, 78, 0.5);
      color: var(--clr-primary-light);
      background: rgba(0, 89, 78, 0.05);
      opacity: 0.9 !important;
    }

    /* Elementos del Modal */
    #close-modal-btn:hover {
      background: var(--clr-primary) !important;
      color: white !important;
      border-color: var(--clr-primary) !important;
    }

    .criteria-input:focus {
      border-color: var(--clr-accent) !important;
      box-shadow: 0 0 0 4px rgba(181, 161, 96, 0.15) !important;
      background: var(--clr-surface) !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
      width: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: var(--clr-surface-hover);
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: var(--clr-border);
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: var(--clr-text-muted);
    }

    @media (max-width: 600px) {
      .dashboard-header {
        padding: 1.5rem;
      }
      .dashboard-header > div:last-child {
        width: 100%;
        justify-content: space-between;
      }
      .modal-content {
        height: 100vh;
        max-height: 100vh !important;
        border-radius: 0;
        border: none;
      }
    }
  </style>

  <script>
    document.addEventListener('astro:page-load', () => {
      const modal = document.getElementById('evaluacion-modal');
      const closeBtn = document.getElementById('close-modal-btn');
      const form = document.getElementById('evaluacion-form') as HTMLFormElement;
      const proyectoNombre = document.getElementById('modal-proyecto-nombre');
      const proyectoIdInput = document.getElementById('proyecto_id') as HTMLInputElement;
      const evalError = document.getElementById('eval-error');
      const submitBtn = document.getElementById('submit-eval-btn') as HTMLButtonElement;

      // Abrir modal
      document.querySelectorAll('.btn-evaluar').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLButtonElement;
          const id = target.getAttribute('data-id');
          const nombre = target.getAttribute('data-nombre');
          
          if (id && nombre && proyectoNombre && proyectoIdInput && modal) {
            proyectoNombre.textContent = nombre;
            proyectoIdInput.value = id;
            form.reset();
            if(evalError) evalError.style.display = 'none';
            modal.classList.add('active');
          }
        });
      });

      // Cerrar modal
      closeBtn?.addEventListener('click', () => {
        modal?.classList.remove('active');
      });

      // Cerrar clickeando afuera
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.remove('active');
        }
      });

      // Enviar formulario
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if(evalError) evalError.style.display = 'none';
        submitBtn.disabled = true;
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Enviando...';

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
          const response = await fetch('/api/jurado/votar', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
          });

          const result = await response.json();

          if (result.success) {
            // Recargar página para actualizar estado a "Evaluado"
            window.location.reload();
          } else {
            throw new Error(result.error || 'Error desconocido al procesar la evaluación.');
          }
        } catch (err: any) {
          if (evalError) {
            evalError.textContent = err.message;
            evalError.style.display = 'block';
          }
          submitBtn.disabled = false;
          submitBtn.textContent = originalText || 'Enviar Evaluación';
        }
      });
    });
  </script>
</MainLayout>
