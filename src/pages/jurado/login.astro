---
import MainLayout from '../../layouts/MainLayout.astro';

// Redirigir al dashboard si ya tiene sesión
const accessToken = Astro.cookies.get('sb-access-token')?.value;
if (accessToken) {
  return Astro.redirect('/jurado/dashboard');
}

const error = Astro.url.searchParams.get('error');
---

<MainLayout title="Acceso Jurados">
  <div class="container section text-center fade-in">
    <div class="card" style="max-width:400px; margin:0 auto; padding:2rem;">
      <h2 class="text-gradient" style="margin-bottom:0.5rem;">Acceso Jurados</h2>
      <p class="text-sm" style="margin-bottom:1.5rem; color:var(--color-text-light);">
        Inicia sesión con tu correo y contraseña para evaluar los proyectos.
      </p>
      
      <form action="/api/jurado/login" method="POST" class="form" style="text-align:left;">
        <div class="form-group">
          <label for="email" class="form-label">Correo electrónico</label>
          <input type="email" id="email" name="email" class="form-control" required placeholder="tu@correo.com" />
        </div>
        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label for="password" class="form-label">Contraseña</label>
          <input type="password" id="password" name="password" class="form-control" required placeholder="********" />
        </div>
        <button type="submit" class="btn btn--primary" style="width:100%;">
          Ingresar
        </button>
        {error === 'credentials' && (
          <p class="text-sm" style="color:var(--color-danger); text-align:center; margin-top:1rem;">
            Credenciales inválidas o no tienes rol de jurado.
          </p>
        )}
        {error === 'server' && (
          <p class="text-sm" style="color:var(--color-danger); text-align:center; margin-top:1rem;">
            Error interno del servidor.
          </p>
        )}
      </form>
    </div>
  </div>
</MainLayout>
